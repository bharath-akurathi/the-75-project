{
  "expo": {
    "name": "The 75 Project",
    "slug": "the-75-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logos/logo.png",
    "scheme": "the75project",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./logos/logo.png",
      "bundleIdentifier": "com.the75project.app"
    },
    "android": {
      "package": "com.the75project.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0A09",
        "foregroundImage": "./logos/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0A09",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01c1b97d-1370-435d-979a-3a3d91654cd6"
      }
    },
    "owner": "bharathakurathi"
  }
}
