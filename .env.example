# The 75 Project — Environment Variables
# NEVER commit .env — only this .env.example goes in the repo

# Supabase (public keys — safe for client)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend API
# Use http://localhost:8000 for local development. 
# Production URL: https://the-75-project-api.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# Backend Services (FastAPI Server)
# NEVER include these in the frontend bundle — they are for the backend only!
# ==============================================================================

# SUPABASE_SERVICE_KEY
# 1. Go to your Supabase Dashboard: https://supabase.com/dashboard/project/gnbpdgohbpzlmaytidba
# 2. Click on the "Settings" (gear icon) in the left sidebar.
# 3. Navigate to "API" under Configuration.
# 4. Scroll down to "Project API keys" and copy the "service_role" secret key.
SUPABASE_SERVICE_KEY=

# NIM_API_KEY
# 1. Go to the NVIDIA Build Portal: https://build.nvidia.com/
# 2. Sign in with your NVIDIA Developer account (create one for free if needed).
# 3. Search for any model in the catalog (e.g., Llama 3.1 Nemotron Vision) and click on it.
# 4. Click the "Generate API Key" button.
# 5. Your key will start with `nvapi-`. Copy and paste it here immediately!
NIM_API_KEY=

# OPENROUTER_API_KEY (Optional fallback)
# Generate from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

JWKS_CACHE_LIFESPAN_SECONDS=600
